    {
      "id": "GE25JXbOS6Iglivk",
      "type": "text",
      "x": 8158,
      "y": 4331,
      "width": 524,
      "height": 337,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 848880197,
      "version": 2,
      "versionNonce": 282166471,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787782338454,
      "link": null,
      "locked": false,
      "text": "carts(id, user_id UNIQUE, status)\ncart_items(id, cart_id, product_id, sku,\n  shop_id, qty, unit_price_snap)\norders(id PK, order_number UNIQUE, buyer_user_id,\n  shop_id, status, subtotal, discount,\n  shipping_fee, tax, grand_total, payment_method,\n  address_snapshot JSON, placed_at)\norder_items(id, order_id, sku, title_snap,\n  unit_price, qty, line_total)\ninvoices(id, order_id UNIQUE, invoice_no, pdf_url)\nvouchers(id, code, scope, shop_id, type, value,\n  min_order, usage_limit, used_count)\nvoucher_redemptions(id, voucher_id, order_id,\n  user_id)   uniq(voucher, user)\noutbox(id, aggregate, event_type, payload,\n  published_at)        <- reliable events\nidempotency_keys(key PK, user_id, response_snap,\n  expires_at)          <- safe retries",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "carts(id, user_id UNIQUE, status)\ncart_items(id, cart_id, product_id, sku,\n  shop_id, qty, unit_price_snap)\norders(id PK, order_number UNIQUE, buyer_user_id,\n  shop_id, status, subtotal, discount,\n  shipping_fee, tax, grand_total, payment_method,\n  address_snapshot JSON, placed_at)\norder_items(id, order_id, sku, title_snap,\n  unit_price, qty, line_total)\ninvoices(id, order_id UNIQUE, invoice_no, pdf_url)\nvouchers(id, code, scope, shop_id, type, value,\n  min_order, usage_limit, used_count)\nvoucher_redemptions(id, voucher_id, order_id,\n  user_id)   uniq(voucher, user)\noutbox(id, aggregate, event_type, payload,\n  published_at)        <- reliable events\nidempotency_keys(key PK, user_id, response_snap,\n  expires_at)          <- safe retries",
      "lineHeight": 1.25,
      "index": "bGF",
      "autoResize": true
    },
