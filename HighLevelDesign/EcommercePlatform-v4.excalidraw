      "link": null,
      "locked": false,
      "type": "text",
      "text": "Cart  (key: cart:{userId})\n- cartId, userId\n- items[] (productId, qty, priceSnapshot)\n- updatedAt, TTL\n\nOrder\n- orderId (PK), userId, shopId\n- items[] (productId, qty, price)\n- shippingFee, totalAmount\n- status // pending|paid|shipped|delivered|cancelled\n- voucherId (nullable)\n- createdAt\n\nVoucher\n- voucherId (PK), code\n- discountType, discountValue, minOrderValue\n- shopId (nullable = platform-wide)\n- usageLimit, expiredAt\n\nInvoice\n- invoiceId (PK), orderId -> Order.orderId\n- totalAmount, taxBreakdown, issuedAt",
      "fontSize": 15,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Cart  (key: cart:{userId})\n- cartId, userId\n- items[] (productId, qty, priceSnapshot)\n- updatedAt, TTL\n\nOrder\n- orderId (PK), userId, shopId\n- items[] (productId, qty, price)\n- shippingFee, totalAmount\n- status // pending|paid|shipped|delivered|cancelled\n- voucherId (nullable)\n- createdAt\n\nVoucher\n- voucherId (PK), code\n- discountType, discountValue, minOrderValue\n- shopId (nullable = platform-wide)\n- usageLimit, expiredAt\n\nInvoice\n- invoiceId (PK), orderId -> Order.orderId\n- totalAmount, taxBreakdown, issuedAt",
      "lineHeight": 1.25,
      "autoResize": true,
      "roundness": null
    },
