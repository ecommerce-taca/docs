    {
      "id": "KIebkUwsm0Ts2fsk",
      "type": "text",
      "x": 51.32951301906519,
      "y": 268.3630260494813,
      "width": 610.5353641167811,
      "height": 277.5157465857287,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 305110133,
      "version": 344,
      "versionNonce": 277729505,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787468641823,
      "link": null,
      "locked": false,
      "text": "• Manage his/her own orders and invoices\n• Sign in, sign up, sign out / update information\n• Search and filter products by keyword / category / price\n• View product details\n• Add products to cart, update quantity [must be signed in]\n• Checkout: address, shipping, payment method [must be signed in]\n• Track order status and cancel before shipping\n• Rate / review product after delivery\n• Choose and apply voucher of system platform or shop\n• Don't need to sign in for search, view product, view shop\n• Must sign in to place an order\n• Can register to become a seller\n. User can payment via VNPAY QR Generate or cash on delivery ",
      "fontSize": 17.077892097583305,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "• Manage his/her own orders and invoices\n• Sign in, sign up, sign out / update information\n• Search and filter products by keyword / category / price\n• View product details\n• Add products to cart, update quantity [must be signed in]\n• Checkout: address, shipping, payment method [must be signed in]\n• Track order status and cancel before shipping\n• Rate / review product after delivery\n• Choose and apply voucher of system platform or shop\n• Don't need to sign in for search, view product, view shop\n• Must sign in to place an order\n• Can register to become a seller\n. User can payment via VNPAY QR Generate or cash on delivery ",
      "lineHeight": 1.25,
      "index": "a5",
      "autoResize": true
    },
